        <item name="iconStarColor">#fdd663</item>

        <item name="textColorPrimaryRecipientDropdown">@android:color/primary_text_dark</item>
        <item name="textColorSecondaryRecipientDropdown">@android:color/secondary_text_dark</item>

        <item name="messageListSwipeSelectColor">#3888FF</item>
        <item name="messageListSwipeToggleReadColor">#3888FF</item>
        <item name="messageListSwipeToggleStarColor">#FFB300</item>
        <item name="messageListSwipeArchiveColor">#30D158</item>
        <item name="messageListSwipeDeleteColor">#FF453A</item>
        <item name="messageListSwipeSpamColor">#FF9F0A</item>
